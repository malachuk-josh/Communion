# --- Clerk (auth) ---
# When these are set, Communion switches from guest demo mode to real Clerk auth.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Upstash Redis (data) ---
# When these are set, Communion persists to Upstash instead of in-memory demo storage.
# On Vercel, add the Upstash integration and these are injected automatically.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- App ---
# Absolute origin used in invite links sent by email/Messenger.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Facebook (optional) ---
# Enables the web Messenger Send Dialog. Mobile deep-link + copy-link work without it.
NEXT_PUBLIC_FACEBOOK_APP_ID=
