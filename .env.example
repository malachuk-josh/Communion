# --- Clerk (auth) ---
# When these are set, Communion switches from guest demo mode to real Clerk auth.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Upstash Redis (data) ---
# When these are set, Communion persists to Upstash instead of in-memory demo storage.
# On Vercel, add the Upstash integration and these are injected automatically.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- App ---
# Absolute origin used in invite links sent by email/Messenger.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Facebook (optional) ---
# Enables the web Messenger Send Dialog. Mobile deep-link + copy-link work without it.
NEXT_PUBLIC_FACEBOOK_APP_ID=

# --- Brevo transactional email (optional) ---
# When both are set, invite emails send from the app (instead of the mailto
# fallback) and the daily session-reminder cron becomes active.
# BREVO_SENDER_EMAIL must be a sender validated in your Brevo account.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# --- Cron protection (recommended in production) ---
# Vercel Cron sends this automatically as a Bearer token when set.
CRON_SECRET=

# --- ESV (optional) ---
# Crossway's own API: free for non-commercial use, 5,000 queries a day.
# Get a key at https://api.esv.org/. Their terms cap what may be stored on a
# device at ~500 verses, so the ESV is read a chapter at a time and never
# downloaded for offline use.
# Both must be set: the public flag is what puts it in the translation list.
NEXT_PUBLIC_ESV=
ESV_API_KEY=

# --- NKJV and NASB via API.Bible (optional) ---
# api.bible's free Starter plan: 5,000 calls a MONTH (not a day), strictly
# non-commercial, and you pick 3 copyrighted Bibles. One key covers all of
# them; each needs its own catalogue id, which is the long hex string from
# GET /v1/bibles, not the name. The same storage limits apply, so these are
# chapter-at-a-time only and never downloaded for offline use.
NEXT_PUBLIC_NKJV=
API_BIBLE_KEY=
API_BIBLE_NKJV_ID=
#
# NEXT_PUBLIC_NASB doubles as the edition: set it to 1995 if that is the one
# licensed, and the copyright line the Lockman Foundation requires changes to
# match. Anything else — 1, true, on — means the current edition.
NEXT_PUBLIC_NASB=
API_BIBLE_NASB_ID=

# --- LSB via YouVersion (optional, and not yet licensed) ---
# A third publisher API: register an app at https://platform.youversion.com to
# get an app key. YOUVERSION_LSB_ID is the numeric version id from
# GET /v1/bibles?language_ranges[]=en&all_available=true — a number, not a hex
# string like API.Bible's.
#
# Turning this on is not by itself permission to serve the text. The LSB's
# quotation allowance (1,000 verses, no complete book) does not cover a
# full-Bible reader, so Three Sixteen Publishing have to agree to it first:
# https://lsbible.org/permission-to-quote-request-form/
NEXT_PUBLIC_LSB=
YOUVERSION_APP_KEY=
YOUVERSION_LSB_ID=
